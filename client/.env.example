# Copy to `.env.local` and adjust. Real env files are git-ignored.

# Server-side only: base URL of the Express API (used by the /api/* rewrite)
API_URL=http://localhost:4000

# Demo login buttons on the login page. Set NEXT_PUBLIC_DEMO_LOGIN=false to hide them.
# NOTE: NEXT_PUBLIC_* values are bundled into the browser JS. Only use this with a
# public demo account that holds fake data.
NEXT_PUBLIC_DEMO_LOGIN=true
NEXT_PUBLIC_DEMO_PASSWORD=Asdfghjk
