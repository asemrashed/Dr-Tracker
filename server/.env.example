# Copy to `.env` and adjust. Real .env files are git-ignored.
NODE_ENV=development
PORT=4000

# Local MongoDB, or an Atlas connection string for deployment
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=24

# Browser origin allowed by CORS (the Next.js app)
CLIENT_ORIGIN=http://localhost:3000

# Shared password for the seeded demo accounts (admin@gmail.com, dr@gmail.com, patient@gmail.com)
SEED_PASSWORD=Asdfghjk
